# Public Privy app ID — safe to expose client-side, this is an identifier, not a secret.
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy app secret — server-only, used by @privy-io/server-auth to verify access tokens.
# Never expose this with a NEXT_PUBLIC_ prefix.
PRIVY_APP_SECRET=

# 4-6 digit PIN staff enter on the customer's own device to authorize a stamp award.
# This is a business-rule gate, not the identity check — identity always comes from the
# customer's own verified Privy access token, never from this PIN.
STAFF_PIN=

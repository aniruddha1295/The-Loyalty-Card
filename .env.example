# ------------------------------------------------------------------
# RTD-P7 — The Loyalty Card That Can't Be Copied
#
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ------------------------------------------------------------------

# Required. Create a free app at https://dashboard.privy.io and
# enable login methods (email + Google) and embedded wallets.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional. Comma-separated email addresses of bakery staff who may
# award stamps. Leave empty to disable the staff counter flow.
# Example: STAFF_EMAILS=priya@rameshbakery.example
STAFF_EMAILS=

# Optional. SQLite database path for customers + stamp history.
DB_PATH=data/loyalty.db

# Optional. Lifetime of a customer counter check-in code, in minutes.
COUNTER_CODE_TTL_MINUTES=5